{
  "manifest_version": 3,
  "name": "Cents Depop Form Diagnostic (Throwaway)",
  "version": "0.0.1",
  "description": "Reports form metadata without reading entered values.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": [
      "https://www.depop.com/products/create",
      "https://www.depop.com/products/create/*"
    ],
    "js": ["scan.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_popup": "popup.html"
  }
}
